{
  "name": "atlas-ems",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed employee management system reference implementation",
  "workspaces": [
    "packages/contracts",
    "packages/platform",
    "services/auth",
    "services/employee",
    "services/attendance",
    "services/payroll",
    "services/notification",
    "services/gateway",
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf \"{apps,packages,services}/**/{dist,coverage}\" coverage",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "test": "jest --runInBand",
    "test:integration": "tsx tests/integration/leave-to-payroll.e2e.ts",
    "test:load": "k6 run load/gateway-health.js",
    "dev:gateway": "npm run start:dev --workspace=@atlas/gateway",
    "dev:web": "npm run dev --workspace=@atlas/web"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
