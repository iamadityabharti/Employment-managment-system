{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@atlas/contracts": ["../../packages/contracts/src/index.ts"],
      "@atlas/contracts/*": ["../../packages/contracts/src/*"]
    }
  },
  "references": [{ "path": "../../packages/contracts" }],
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
