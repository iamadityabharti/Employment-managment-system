# Copy this file to .env for Docker Compose. Do not use these development values in production.
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Infrastructure credentials
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_password
POSTGRES_PORT=5432
AUTH_DATABASE_URL=postgresql://atlas:atlas_dev_password@postgres:5432/auth_db
EMPLOYEE_DATABASE_URL=postgresql://atlas:atlas_dev_password@postgres:5432/employee_db
ATTENDANCE_DATABASE_URL=postgresql://atlas:atlas_dev_password@postgres:5432/attendance_db
PAYROLL_DATABASE_URL=postgresql://atlas:atlas_dev_password@postgres:5432/payroll_db

REDIS_URL=redis://redis:6379
RABBITMQ_DEFAULT_USER=atlas
RABBITMQ_DEFAULT_PASS=atlas_dev_password
RABBITMQ_URL=amqp://atlas:atlas_dev_password@rabbitmq:5672
MONGODB_INITDB_ROOT_USERNAME=atlas
MONGODB_INITDB_ROOT_PASSWORD=atlas_dev_password
MONGODB_URI=mongodb://atlas:atlas_dev_password@mongo:27017/notification_db?authSource=admin

# Auth and rate limiting
JWT_ACCESS_SECRET=replace-this-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-this-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Service behavior
OUTBOX_POLL_MS=1000
EMPLOYEE_SERVICE_URL=http://employee:3002
AUTH_SERVICE_URL=http://auth:3001
ATTENDANCE_SERVICE_URL=http://attendance:3003
PAYROLL_SERVICE_URL=http://payroll:3004
NOTIFICATION_SERVICE_URL=http://notification:3005
NOTIFICATION_EMAIL_FROM=no-reply@atlas.local
NOTIFICATION_EMAIL_MODE=mock
VITE_API_BASE_URL=http://localhost:3000
